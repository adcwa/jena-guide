@prefix ex:  <https://example.org/vehicle/> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:RevisionShape a sh:NodeShape ; sh:targetClass ex:PartRevision ;
  sh:property [ sh:path ex:revisionOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path ex:unitPrice ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
  sh:property [ sh:path ex:currency ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .
ex:LineShape a sh:NodeShape ; sh:targetClass ex:BOMLine ;
  sh:property [ sh:path ex:usesRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ex:PartRevision ] ;
  sh:property [ sh:path ex:quantity ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:datatype xsd:decimal ; sh:minExclusive 0 ] .
ex:BOMShape a sh:NodeShape ; sh:targetClass ex:BOM ;
  sh:property [ sh:path ex:vehicleModel ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path ex:configuration ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path ex:status ; sh:minCount 1 ; sh:maxCount 1 ; sh:in (ex:Draft ex:Released) ] ;
  sh:property [ sh:path ex:validFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ;
                sh:lessThan ex:validTo ] ;
  sh:property [ sh:path ex:validTo ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
  sh:property [ sh:path ex:hasLine ; sh:minCount 1 ; sh:class ex:BOMLine ] .
ex:ChangeShape a sh:NodeShape ; sh:targetClass ex:ChangeOrder ;
  sh:property [ sh:path ex:fromRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ex:PartRevision ] ;
  sh:property [ sh:path ex:toRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ex:PartRevision ] ;
  sh:sparql [ a sh:SPARQLConstraint ;
    sh:message "Old and new revisions must be different revisions of one part, with the same currency." ;
    sh:select """
      PREFIX ex: <https://example.org/vehicle/>
      SELECT $this WHERE {
        $this ex:fromRevision ?old ; ex:toRevision ?new .
        FILTER (?old = ?new || NOT EXISTS {
          ?old ex:revisionOf ?part ; ex:currency ?currency .
          ?new ex:revisionOf ?part ; ex:currency ?currency .
        })
      }
    """
  ] .
